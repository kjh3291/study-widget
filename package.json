{
  "name": "everytime-widget",
  "version": "1.3.2",
  "description": "충북대 LMS·에브리타임 연동 공부용 데스크톱 위젯 (시간표·할 일·일정·출석·기록)",
  "main": "main.js",
  "author": "study-widget contributors",
  "license": "MIT",
  "repository": "https://github.com/kjh3291/study-widget",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "test": "node scripts/test-deleted-files.js && node scripts/test-sync-reliability.js && node scripts/test-git-sync.js && node scripts/test-shared-settings.js && node scripts/test-input-downloads.js && node scripts/test-syllabus.js",
    "test:ui": "electron scripts/test-sync-ui.cjs && electron scripts/test-sync-main.cjs && electron scripts/test-syllabus-ui.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cbnu.studywidget",
    "productName": "StudyWidget",
    "artifactName": "StudyWidget-${version}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "sync-fields.js",
      "sync-model.js",
      "sync-storage.js",
      "sync-service.js",
      "sync-conflicts.js",
      "material-history.js",
      "syllabus.js",
      "syllabus-pdf.js",
      "lms.js",
      "index.html",
      "icon.ico",
      "icon.png",
      "package.json",
      "deleted-files.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "StudyWidget-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "스터디 위젯"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "artifactName": "StudyWidget-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "4.8.69"
  }
}
