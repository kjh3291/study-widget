# 서버의 ~/studeck/<prod|lab>/server/.env 로 복사해 채운다(권한 600, git 제외).
COMPOSE_PROJECT_NAME=studeck-lab
STUDECK_CHANNEL=lab
BIND_IP=100.96.247.43
API_PORT=8444
DB_PASSWORD=
# 이 아이디로 가입하면 운영진(admin)으로 바로 승인
ADMIN_USERNAME=
# 실험실 전용: 이 숫자로 시작하는 가짜 학번(자동 테스트 계정)만 바로 승인(운영에서는 무시)
AUTO_APPROVE_PREFIX=99
# 운영(Funnel 뒤)만 true: X-Forwarded-For 마지막 값을 실제 접속 IP로 사용
TRUST_PROXY=false
# 시도 제한(10분 로그인/1시간 가입, IP당). 자동 테스트가 도는 실험실은 높게
LOGIN_IP_LIMIT=300
SIGNUP_IP_LIMIT=300
